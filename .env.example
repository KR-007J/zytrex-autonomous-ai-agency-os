# ============================================================
# LEADFORGE ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment (development | production)
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./data/leadforge.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://leadforge:password@localhost:5432/leadforge_db

# Security
SECRET_KEY=generate_a_secure_random_secret_in_production_32_chars

# Crawler Settings
CRAWLER_TIMEOUT=10.0
CRAWLER_CONCURRENCY=10
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; LeadForgeBot/2.0; +https://leadforge.io/bot)

# Feature Flags
ENABLE_COMMON_CRAWL=true
ENABLE_CERT_TRANSPARENCY=true
ENABLE_DNS_DISCOVERY=true
ENABLE_AI_LAYER=false
